/-!
# Spot certificates of the helpers of a variable group (generated)

`spotVarB i T`: the target of `T` is the spot of witness `i`, the certificate is valid, and its
escaping cone stays in `−100 < x < 100` on the low strip.
-/

namespace ArtGallery.Orthogonal.Hard

@[expose] public section

/-- The spot certificate check of witness `i` of a variable group. -/
def spotVarB (i : ℕ) (T : TCert) : Bool :=
  decide (gVarD.sps.getD i LR.dflt = T.A) && (T.cert gVarD.gs).ok &&
    decide (T.cones.length = (groupLR gVarD.gs).length) && lowSlabB T (-100) 100

