section SlotaddLe

variable {c : ℕ} (hc : c < paramC Φ) (hk : cKind (gadAt Φ c) = .addLe)
include hc hk

theorem alT_zone : fzone alT (paramH n Φ) (slotG n Φ c) ∈ zfO n Φ := by
  simp only [zfO, List.mem_append, List.mem_flatMap, List.mem_map, List.mem_range]
  exact Or.inr ⟨c, hc, alT, by rw [hk]; exact alT_mem, rfl⟩

omit hc hk in
/-- The room `X` of `addLe`. -/
noncomputable def alOXRoom (n : ℕ) (Φ : List Constraint) (c : ℕ) : Set Point :=
  gridRoomSet (tzX alT (fz alT) ((slotG n Φ c : ℚ) : ℝ)) (tzY alT (fz alT) ((paramH n Φ : ℚ) : ℝ)) alOXRR

/-- **The room `X` of `addLe`**, with its vertical door. -/
theorem alOX_room :
