section SlotaddGe

variable {c : ℕ} (hc : c < paramC Φ) (hk : cKind (gadAt Φ c) = .addGe)
include hc hk

theorem agT_zone : fzone agT (paramH n Φ) (slotG n Φ c) ∈ zfO n Φ := by
  simp only [zfO, List.mem_append, List.mem_flatMap, List.mem_map, List.mem_range]
  exact Or.inr ⟨c, hc, agT, by rw [hk]; exact agT_mem, rfl⟩

omit hc hk in
/-- The room `Y` of `addGe`. -/
noncomputable def agOYRoom (n : ℕ) (Φ : List Constraint) (c : ℕ) : Set Point :=
  gridRoomSet (tzX agT (fz agT) ((slotG n Φ c : ℚ) : ℝ)) (tzY agT (fz agT) ((paramH n Φ : ℚ) : ℝ)) agOYRR

/-- **The room `Y` of `addGe`**, with its vertical door. -/
theorem agOY_room :
    (Polygon.mk ((polyO n Φ).map ratPoint)).IsRoom (agOYRoom n Φ c)
      (segment ((slotG n Φ c : ℝ) + 50, (-94)) ((slotG n Φ c : ℝ) + 50, (-77))) := by
  have h := tmplRoomV (n := n) (ox := (slotG n Φ c : ℚ)) (mem_allFloorTmpls_slot agT_mem)
    (agT_zone (n := n) hc hk) agOY_roomB
  have e : ((slotG n Φ c : ℚ) : ℝ) = (slotG n Φ c : ℝ) := by push_cast; rfl
  rw [agT_X48, agT_Y24, agT_Y25, e] at h
  exact h

omit hc hk in
theorem agOY_bounds {z : Point} (hz : z ∈ agOYRoom n Φ c) :
    (slotG n Φ c : ℝ) + 2891 / 128 ≤ z.1 ∧ z.1 ≤ (slotG n Φ c : ℝ) + 52 ∧ (-7355 / 64) ≤ z.2 ∧ z.2 ≤ (-153 / 2) := by
  have hf := fz_facts (mem_allFloorTmpls_slot agT_mem)
  have hD := floorTmpl_D (mem_allFloorTmpls_slot agT_mem)
  have hH : (1000 : ℝ) ≤ ((paramH n Φ : ℚ) : ℝ) := by exact_mod_cast paramH_ge_q n Φ
  have hNX : (fz agT).zone.NX = 87 := by rw [agT_fz]; rfl
  have hNY : (fz agT).zone.NY = 76 := by rw [agT_fz]; rfl
  have hφ := tz_monoX hf hD ((slotG n Φ c : ℚ) : ℝ)
  have hψ := tz_monoY hf hD hH
  rw [hNX] at hφ; rw [hNY] at hψ
  have := gridRoom_bounds hφ hψ (by norm_num) (by norm_num) agOY_boxB hz
  have e : ((slotG n Φ c : ℚ) : ℝ) = (slotG n Φ c : ℝ) := by push_cast; rfl
  rw [agT_X2, agT_X50, agT_Y9, agT_Y26, e] at this
  exact this

